+def _column_shuffle(matrix: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    out = matrix.copy()
+    n = matrix.shape[0]
+    for j in range(matrix.shape[1]):
+        perm = rng.permutation(n)
+        out[:, j] = matrix[perm, j]
+    return out
+
