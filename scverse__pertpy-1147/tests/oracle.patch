+        ],
+        columns=["contrast", "variable", "log_fc", "sd", "p_value"],
+    ).set_index(["contrast", "variable"])
+    np.testing.assert_allclose(res[expected.columns].to_numpy(), expected.sort_index().to_numpy(), rtol=1e-5)
+
