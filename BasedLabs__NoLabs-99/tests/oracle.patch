diff --git a/.github/workflows/diffdock-master.yaml b/.github/workflows/diffdock-master.yaml
new file mode 100644
index 00000000..e2452ba7
--- /dev/null
+++ b/.github/workflows/diffdock-master.yaml
@@ -0,0 +1,29 @@
+name: diffdock-master
+run-name: diffdock-master
+
+# Build and push nolabs image using GitHub Cache API
+# Only if relevant files were changed
+
+on: workflow_dispatch
+
+jobs:
+  build:
+    permissions:
+      contents: read
+      packages: write
+
+    uses: ./.github/workflows/build-docker.yaml
+    with:
+      microservice_name: "diffdock"
+
+  push:
+    if: github.repository == 'BasedLabs/NoLabs'
+    needs: build
+
+    permissions:
+      contents: read
+      packages: write
+
+    uses: ./.github/workflows/push-docker.yaml
+    with:
+      microservice_name: "diffdock"
diff --git a/.github/workflows/diffdock-pr.yaml b/.github/workflows/diffdock-pr.yaml
new file mode 100644
index 00000000..9371a23b
--- /dev/null
+++ b/.github/workflows/diffdock-pr.yaml
@@ -0,0 +1,22 @@
+name: diffdock-pr
+run-name: diffdock-pr
+
+# Build and push nolabs image using GitHub Cache API
+# Only if relevant files were changed
+
+on:
+  pull_request:
+    branches:
+      - master
+    paths:
+      - 'microservices/diffdock/**'
+
+jobs:
+  build:
+    permissions:
+      contents: read
+      packages: write
+
+    uses: ./.github/workflows/build-docker.yaml
+    with:
+      microservice_name: "diffdock"
