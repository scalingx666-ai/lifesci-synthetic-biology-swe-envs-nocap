new file mode 100644
index 00000000..4922b81b
--- /dev/null
+++ b/.github/workflows/rosettafold-pr.yaml
@@ -0,0 +1,22 @@
+name: rosettafold-pr
+run-name: rosettafold-pr
+
+# Build and push nolabs image using GitHub Cache API
+# Only if relevant files were changed
+
+on:
+  pull_request:
+    branches:
+      - master
+    paths:
+      - 'microservices/rosettafold/**'
+
+jobs:
+  build:
+    permissions:
+      contents: read
+      packages: write
+
+    uses: ./.github/workflows/build-docker.yaml
+    with:
+      microservice_name: "rosettafold"
