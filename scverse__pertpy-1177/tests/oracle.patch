+    dl = Dialogue(celltype_key="ct", sample_key="s")
+    out = dl._program_celltypes(emp, celltypes)
+    assert out["MCP1"] == ["A", "C", "D", "E"]
+    assert out["MCP2"] == ["A", "B", "C", "D"]
